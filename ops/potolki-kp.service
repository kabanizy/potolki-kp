[Unit]
Description=Potolki KP Docker Compose application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/potolki-kp
ExecStart=/bin/sh /opt/potolki-kp/ops/ensure-up.sh
ExecStop=/usr/bin/docker compose stop
Restart=on-failure
RestartSec=30s
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
